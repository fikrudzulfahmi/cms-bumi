<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # "/" harus lewat front controller agar meta SEO tersusun
    RewriteRule ^$ index.php [L]

    # Jangan biarkan index.html mentah diakses langsung (tanpa meta SEO)
    RewriteRule ^index\.html$ / [R=301,L]

    # Berkas/folder yang benar-benar ada dilayani langsung (aset, gambar, favicon)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Semua rute lain -> front controller (menyusun meta SEO, lalu mengirim SPA).
    # robots.txt & sitemap.xml juga dilayani dari sini.
    RewriteRule ^ index.php [L]
</IfModule>

# Pastikan front controller yang dipakai untuk direktori
DirectoryIndex index.php index.html

# Cache aset ber-hash
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
